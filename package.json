{
  "name": "hl-app-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:all": "npm run build && npm --prefix functions run build",
    "functions:build": "npm --prefix functions run build",
    "preview": "vite preview",
    "emulators": "npx -y firebase-tools@latest emulators:start",
    "deploy:all": "npm run build:all && npx -y firebase-tools@latest deploy"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-vue-next": "^1.0.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.10.4",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
